# Environment variables example for Rubato Streamlit App
# Copy this file to .env and modify as needed for your deployment

# Application settings
APP_NAME=rubato-streamlit
APP_VERSION=1.0.0
ENVIRONMENT=production

# Server configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true

# Resource optimization for t3.medium
TORCH_NUM_THREADS=2
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2

# Model settings
MODEL_DOWNLOAD_TIMEOUT=300
MODEL_CACHE_DIR=/app/models

# Logging
LOG_LEVEL=INFO
ACCESS_LOG_ENABLED=true

# Security (Optional - for future features)
# STREAMLIT_SHARING_MODE=off
# STREAMLIT_GATHER_USAGE_STATS=false

# Database (Optional - for future features)
# DATABASE_URL=sqlite:///app/logs/app.db

# External APIs (Optional - for future integrations)
# HUGGINGFACE_TOKEN=your_hf_token_here
# OPENAI_API_KEY=your_openai_key_here

# AWS Configuration (if using S3 for model storage)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_DEFAULT_REGION=us-east-1
# S3_BUCKET_NAME=your-model-bucket

# Monitoring (Optional)
# SENTRY_DSN=your_sentry_dsn
# NEW_RELIC_LICENSE_KEY=your_newrelic_key
